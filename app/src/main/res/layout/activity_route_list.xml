<?xml version="1.0" encoding="utf-8"?>
<!--
  The results half of the old Route Options screen. Route Options keeps the
  selectors; everything here is read-only output, so the trip is restated in a
  single strip at the top rather than re-offered as editable fields.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:navigationIcon="@drawable/ic_back"
            app:title="Routes"
            app:titleTextColor="@color/text_primary"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRoutes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- What was asked for — restated, not re-offered -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTripEnds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvTripDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11.5sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recommended routes header -->
            <LinearLayout
                android:id="@+id/rowResultsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recommended routes"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvRouteCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"/>
            </LinearLayout>

            <!--
              Route filter. Each segment shows its own short list chosen by the
              engine: Train = train/metro only, Bus = bus only, Mixed = both.
              Same track and thumb as the toggle on the live-status screen.
            -->
            <LinearLayout
                android:id="@+id/rowRouteFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_segment_group"
                android:visibility="gone">

                <TextView
                    android:id="@+id/segFilterAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="All"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/segFilterTrain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="Train"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/segFilterBus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="Bus"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/segFilterMixed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="Mixed"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvFilterEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginVertical="20dp"
                android:visibility="gone"/>

            <ProgressBar
                android:id="@+id/progressSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="24dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No routes found"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/llRoutesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Footnote — sits after every route, whatever the mode -->
            <LinearLayout
                android:id="@+id/noteEstimates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_info_note"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info"
                    android:layout_marginTop="1dp"
                    android:contentDescription="Note"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Travel times are estimates and may vary based on live conditions."
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_muted"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Stays reachable at the top once the route header scrolls away -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCollapseRoute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_collapse_up"
        android:contentDescription="Collapse route"
        android:visibility="gone"
        app:backgroundTint="@color/accent_blue"
        app:fabSize="mini"
        app:tint="@null"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
