<?xml version="1.0" encoding="utf-8"?>
<!-- A station "stop" node in the journey timeline -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="48dp">

    <!-- Left column: dot + connecting line -->
    <LinearLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/viewLineTop"
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:background="#E5E7EB"/>

        <!-- Circular dot -->
        <View
            android:id="@+id/viewDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_step"/>

        <View
            android:id="@+id/viewLineBottom"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#E5E7EB"/>
    </LinearLayout>

    <!-- Right column: all content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="8dp">

        <!-- Station name -->
        <TextView
            android:id="@+id/tvStationName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <!-- Sub-label -->
        <TextView
            android:id="@+id/tvStationSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:visibility="gone"/>

        <!-- Line chip row -->
        <LinearLayout
            android:id="@+id/llLinePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLinePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/pill_bg"/>

            <TextView
                android:id="@+id/tvLegInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textColor="@color/text_muted"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <!-- "N stops along the way" toggle -->
        <TextView
            android:id="@+id/tvSkippedToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11.5sp"
            android:textColor="@color/accent_blue"
            android:textStyle="normal"
            android:layout_marginTop="6dp"
            android:visibility="gone"/>

        <!-- Skipped stops list (collapsed by default) -->
        <LinearLayout
            android:id="@+id/llSkippedStops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <!-- Train timings table — always visible once data loads, styled as a box -->
        <LinearLayout
            android:id="@+id/llTrainTimings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:padding="12dp"
            android:background="@drawable/panel_bg"/>

    </LinearLayout>
</LinearLayout>
