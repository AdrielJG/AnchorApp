<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/tvComposerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvComposerRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/text_muted"/>

    <!-- Attachment rows, shown only for what this report uses -->
    <LinearLayout
        android:id="@+id/rowTrain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_train_card"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTrainLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/text_hint"/>

        <TextView
            android:id="@+id/tvTrainValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowStation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_train_card"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/text_hint"/>

        <TextView
            android:id="@+id/tvStationValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPlatform"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_train_card"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPlatformLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/text_hint"/>

        <TextView
            android:id="@+id/tvPlatformValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etComposerNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chat_input"
        android:hint="Add a detail (optional)"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:maxLines="3"
        android:inputType="textCapSentences|textMultiLine"
        android:importantForAutofill="no"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPostReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Post report"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:letterSpacing="0"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"/>
</LinearLayout>
