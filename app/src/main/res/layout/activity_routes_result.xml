<?xml version="1.0" encoding="utf-8"?>
<!--
  Route Options — setting the trip up, and nothing else.

  The results used to sit underneath all of this, which meant the boarding and
  alighting selectors scrolled off the moment they produced anything. They now
  have the screen to themselves and hand over to RouteListActivity.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        android:elevation="0dp"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_primary"
            app:title="Route Options"
            app:titleTextColor="@color/text_primary"
            app:titleTextAppearance="@style/RouteOptionsTitle"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="4dp">

            <!--
              Journey card. Origin defaults to the commuter's GPS fix and both
              ends stay editable here, so the trip can be adjusted before the
              search rather than re-entered on the home screen.
            -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- ORIGIN -->
                        <LinearLayout
                            android:id="@+id/rowOrigin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_origin_ring"
                                android:contentDescription="Origin"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:id="@+id/tvOriginLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="My Location"
                                    android:textSize="14.5sp"
                                    android:textColor="@color/text_primary"
                                    android:singleLine="true"
                                    android:ellipsize="end"/>

                                <TextView
                                    android:id="@+id/tvOriginSub"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="11.5sp"
                                    android:textColor="@color/text_hint"
                                    android:singleLine="true"
                                    android:ellipsize="end"
                                    android:layout_marginTop="1dp"
                                    android:visibility="gone"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Dotted rail between the two markers -->
                        <LinearLayout
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingVertical="1dp">

                            <View android:layout_width="3dp" android:layout_height="3dp"
                                android:background="@drawable/dotted_connector"/>
                            <View android:layout_width="3dp" android:layout_height="3dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/dotted_connector"/>
                            <View android:layout_width="3dp" android:layout_height="3dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/dotted_connector"/>
                        </LinearLayout>

                        <!-- DESTINATION -->
                        <LinearLayout
                            android:id="@+id/rowDest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_dest_pin"
                                android:contentDescription="Destination"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:id="@+id/tvDestLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Where would you like to go?"
                                    android:textSize="14.5sp"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_hint"
                                    android:singleLine="true"
                                    android:ellipsize="end"/>

                                <TextView
                                    android:id="@+id/tvDestSub"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="11.5sp"
                                    android:textColor="@color/text_hint"
                                    android:singleLine="true"
                                    android:ellipsize="end"
                                    android:layout_marginTop="1dp"
                                    android:visibility="gone"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnSwapOd"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_swap_vert"
                        android:scaleType="centerInside"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Swap origin and destination"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!--
              BOARD AT — one card per end of the trip. When both a railway
              station and a metro station are in range the card becomes two
              pages the commuter slides between; with only one mode in range it
              is a plain card with that mode named in the title.
            -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBoard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="@color/surface"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/rowBoardHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:id="@+id/ivBoardIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_mode_rail"
                            android:contentDescription="Mode"/>

                        <TextView
                            android:id="@+id/tvBoardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Board at (Railway)"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="10dp"/>

                        <LinearLayout
                            android:id="@+id/llBoardDots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Switch between railway and metro"/>
                    </LinearLayout>

                    <com.example.mumbaitransit.ui.SwipeSwitcher
                        android:id="@+id/switcherBoard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/gridBoardRail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>

                        <LinearLayout
                            android:id="@+id/gridBoardMetro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </com.example.mumbaitransit.ui.SwipeSwitcher>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- GET OFF AT -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="@color/surface"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/rowOffHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:id="@+id/ivOffIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_mode_rail"
                            android:contentDescription="Mode"/>

                        <TextView
                            android:id="@+id/tvOffTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Get off at (Railway)"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="10dp"/>

                        <LinearLayout
                            android:id="@+id/llOffDots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Switch between railway and metro"/>
                    </LinearLayout>

                    <com.example.mumbaitransit.ui.SwipeSwitcher
                        android:id="@+id/switcherOff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/gridOffRail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>

                        <LinearLayout
                            android:id="@+id/gridOffMetro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </com.example.mumbaitransit.ui.SwipeSwitcher>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- DEPARTURE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:id="@+id/rowDepartTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_train_time"
                            android:contentDescription="Departure time"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Departure"
                            android:textSize="13.5sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="10dp"/>

                        <TextView
                            android:id="@+id/tvDepartTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Now"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:gravity="end"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="@color/accent_blue"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_down"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Change time"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDepartHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Trains leaving in the next 2 hours will be shown."
                        android:textSize="10.5sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/text_hint"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Plain-language read-back of everything above -->
            <LinearLayout
                android:id="@+id/panelSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/panel_bg"
                android:padding="14dp"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_train_place"
                    android:layout_marginTop="1dp"
                    android:contentDescription="Trip"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tvSummaryEnds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvSummaryDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvOptionsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:layout_marginTop="18dp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- The hand-off. Everything above is a choice; this is the only action. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_primary"
        android:elevation="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/btnSeeRoutes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_primary_action"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See Routes"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/surface"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_forward"
                android:layout_marginStart="10dp"
                android:contentDescription="See routes"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
