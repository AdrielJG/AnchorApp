<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="2dp"
        app:title="Route map"
        app:titleTextColor="@color/text_primary"/>

    <!-- Map takes whatever the legend panel below does not -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp">

        <fragment
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/tvMapEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:background="@color/bg_primary"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:text="This route has no mapped path."
            android:visibility="gone"/>

        <!--
          Status strip for the Directions fetch on auto and cab routes. Sits over
          the map so a dashed placeholder is never mistaken for a real road path
          while the request is still running, or after it has failed.
        -->
        <TextView
            android:id="@+id/tvMapNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/surface"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:elevation="2dp"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Leg legend: colour swatch per leg, matching the polylines above -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="6dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRouteTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvRouteSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvEndpoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11.5sp"
                android:textColor="@color/text_muted"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:background="@color/border"/>

            <!--
              Height is set in code: short journeys wrap, long ones are capped
              so the legend can never crowd the map off the screen.
            -->
            <ScrollView
                android:id="@+id/svLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <!-- Hand-off to Google Maps for turn-by-turn on road routes -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenInMaps"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Open in Google Maps"
                android:textSize="12.5sp"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:visibility="gone"
                app:icon="@drawable/ic_map_route"
                app:iconGravity="textStart"
                app:iconSize="16dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
