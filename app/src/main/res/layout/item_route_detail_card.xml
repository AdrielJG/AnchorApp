<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Route Header (always visible, clickable to expand/collapse) -->
        <LinearLayout
            android:id="@+id/layoutRouteHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <!-- Color accent bar -->
            <View
                android:id="@+id/viewAccent"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:minHeight="60dp"
                android:background="#1a56db"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <!-- Top row: scenario label + time + fare -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvScenarioLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvFare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Mode string -->
                <TextView
                    android:id="@+id/tvModeStr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="4dp"/>

                <!-- Lines used -->
                <TextView
                    android:id="@+id/tvLines"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/accent_blue"
                    android:layout_marginBottom="6dp"/>

                <!-- Transfers + MRI row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTransfers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"/>

                    <TextView
                        android:id="@+id/tvMri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone"/>

                    <ImageView
                        android:id="@+id/ivExpandCollapse"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@android:drawable/arrow_down_float"
                        android:contentDescription="Expand/Collapse"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Expandable Journey Details Section -->
        <LinearLayout
            android:id="@+id/layoutJourneyDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="16dp"/>

            <!--
              Next step + the button that starts live navigation. The button
              names the first thing the rider actually does: "Start Walking"
              when the route opens with a walk, "Start Journey" when it opens
              by boarding, "Resume Navigation" when this route is already being
              navigated. Filled in RouteListActivity.bindNextStep().
            -->
            <LinearLayout
                android:id="@+id/panelNextStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_next_step"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_nav_icon_circle">

                        <ImageView
                            android:id="@+id/ivNextStepIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_walk"
                            android:contentDescription="First step"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next step"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/green"
                            android:background="@drawable/pill_bg"
                            android:backgroundTint="#D3EEDD"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"/>

                        <TextView
                            android:id="@+id/tvNextStepTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/tvNextStepMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textSize="12.5sp"
                            android:textColor="@color/text_muted"/>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartNavigation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Start Walking"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    app:icon="@drawable/ic_navigate"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/accent_blue"/>
            </LinearLayout>

            <!-- Walk summary line -->
            <TextView
                android:id="@+id/tvWalkSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="12dp"/>

            <!-- Journey Timeline (dynamically populated) -->
            <LinearLayout
                android:id="@+id/llPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"/>

            <!-- Train option pager — steps every rail leg to its next train together -->
            <LinearLayout
                android:id="@+id/layoutTrainPager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevTrain"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹  Prev"
                    android:textSize="12sp"
                    android:letterSpacing="0"
                    android:textAllCaps="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <TextView
                    android:id="@+id/tvTrainPagerIndicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextTrain"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next  ›"
                    android:textSize="12sp"
                    android:letterSpacing="0"
                    android:textAllCaps="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

            <!-- MRI Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RELIABILITY INDEX"
                        android:textSize="10sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_hint"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:id="@+id/llMri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Loading indicator for timetable -->
            <ProgressBar
                android:id="@+id/progressTimings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!--
          Compact actions. Outside layoutJourneyDetails on purpose: Save, Share,
          Live Journey and View Map stay in the same place whether the card is
          open or closed, so nothing has to be duplicated for the two states.
        -->
        <include
            android:id="@+id/routeActions"
            layout="@layout/view_route_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
